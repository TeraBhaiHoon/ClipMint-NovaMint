# Supabase project URL (Supabase dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
# Supabase anon/public key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Supabase service_role key — server only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Public base URL of this dashboard (used in notification links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Cloudflare Worker API gateway base URL
NEXT_PUBLIC_API_URL=http://localhost:8787

# GitHub fine-grained PAT with "Actions: write" on GITHUB_REPO
GITHUB_TOKEN=ghp_your_github_token_here
# Repo that hosts .github/workflows/process-video.yml, as "owner/repo"
GITHUB_REPO=TeraBhaiHoon/ClipMint-NovaMint

# Shared secret the pipeline sends to POST /api/webhooks/job-status
WEBHOOK_SECRET=generate_a_long_random_string
# Resend API key for transactional email (optional — email is best-effort)
RESEND_API_KEY=re_your_resend_key_here
# Bearer token required by GET /api/cron/keep-alive (endpoint fails closed without it)
CRON_SECRET=generate_a_long_random_string

# Cashfree Payment Gateway (api/cashfree/* routes + pricing checkout)
# CASHFREE_ENV: "SANDBOX" (default) or "PRODUCTION" — switches gateway + API version env
CASHFREE_ENV=SANDBOX
# Merchant Dashboard → Settings → API Keys
CASHFREE_APP_ID=your_cashfree_app_id_here
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here
# Public app id exposed to the browser checkout (usually the same as CASHFREE_APP_ID)
NEXT_PUBLIC_CASHFREE_APP_ID=your_cashfree_app_id_here
# Webhook secret set in Merchant Dashboard → Settings → Webhooks. When set it is
# used for HMAC webhook signature verification (recommended); when unset the SDK
# verifies against the API secret key instead.
CASHFREE_WEBHOOK_SECRET=generate_a_long_random_string

# ── Clip delivery (R2 24h cache) + archive recovery ──────────────────────
# Used by /api/clips/[clipId]/download: fast path = presigned R2 GET;
# fallback = re-materialise the clip from the permanent Google Drive archive.
#
# Cloudflare account id (R2 overview page — the account that owns the bucket)
R2_ACCOUNT_ID=your_cloudflare_account_id_here
# Object Read & Write API token keys (Cloudflare → R2 → Manage API Tokens).
# Same values as the GitHub secrets R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY.
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
# The delivery bucket (lifecycle rules: delivery/ 1 day, sources/ 7 days).
# The code also accepts R2_BUCKET as a fallback name for this value.
R2_DELIVERY_BUCKET=clipmint-delivery
# Base64 ("-w0") of the rclone.conf the pipeline uses for the Drive archive.
# EXACTLY the same value as the GitHub secret RCLONE_CONF_B64. Leave empty to
# serve R2-only downloads (older clips re-materialise only when this or the
# service-account alternative below is set).
RCLONE_CONF_B64=
# Alternative to RCLONE_CONF_B64: base64 of a Google service-account JSON with
# access to the archive Drive folder. Set ONE of the two, not both.
GOOGLE_SERVICE_ACCOUNT_JSON_B64=

# ══ TeraBhaiHoon/ClipMint-NovaMint GitHub repo secrets ══════════════════
# These belong to the PROCESSING repo (Actions workflows read them via
# secrets.*). Set them as GitHub repo secrets there — not on Vercel.

# The pipeline's Notify step POSTs job results to this URL + WEBHOOK_SECRET.
# Same value as NEXT_PUBLIC_APP_URL (the production dashboard).
DASHBOARD_URL=https://your-dashboard-url-here

# Aliases of dashboard keys above (same values, different secret names):
#   SUPABASE_URL          = NEXT_PUBLIC_SUPABASE_URL
#   SUPABASE_SERVICE_KEY  = SUPABASE_SERVICE_ROLE_KEY
#   SUPABASE_ANON_KEY     = NEXT_PUBLIC_SUPABASE_ANON_KEY

# Speech-to-text fallback chain: Groq → Deepgram → NVIDIA NIM
GROQ_API_KEY=
DEEPGRAM_API_KEY=
NVIDIA_NIM_API_KEY=
# Google Drive folder that receives the permanent clip archive
GDRIVE_FOLDER_ID=
# Fine-grained PAT (Contents:write on the website repo) — sync-web.yml
# mirrors dashboard/ to the website repo on every push
REPO_A_TOKEN=
